# Cortex Auto-Environment
# Activated automatically when you cd into this directory

# Auto-activate Python virtual environment
source venv/bin/activate

# Load environment variables from .env (if exists)
dotenv_if_exists .env

# Add project bins to PATH
PATH_add scripts
PATH_add batch
PATH_add supervisor

# Cortex-specific environment
export CORTEX_ROOT="$PWD"
export PYTHONPATH="$PWD:$PYTHONPATH"
export CORTEX_HOME="$HOME/.cortex"

# Quick feedback
echo "🧠 Cortex environment activated (venv loaded)"

# Anthropic Batch API Key (for overnight Claude analysis)
export ANTHROPIC_API_KEY=$(cat ~/.cortex/secrets/anthropic_batch_key 2>/dev/null || echo "")
