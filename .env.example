# Cortex — Environment Configuration
# Copy this file to .env and fill in your values.
# Required vars are marked [REQUIRED], all others are optional.

# [REQUIRED] Anthropic API key — powers all intelligence/embedding features
ANTHROPIC_API_KEY=your-api-key-here

# [REQUIRED] Root directory that CONTAINS your projects (git repos).
# Used for project detection and git scanning. Example: ~/Dev or ~/code
CORTEX_ROOT_DIR=~/Dev
# (Cortex state — databases, logs, prompts — lives at ~/.cortex and is not
#  configurable here.)

# Domain scope: "aidev" (personal/OSS) or "databricks" (work)
# Controls which outcomes/insights are visible. Default: aidev
# CORTEX_DOMAIN=aidev

# API key for authenticating to the Cortex REST bridge
# CORTEX_API_KEY=

# --- Gateway (Coming Soon) ---
# Telegram bot token from @BotFather — required for Telegram gateway
# CORTEX_TELEGRAM_TOKEN=
# Bridge server URL (default: http://127.0.0.1:8765)
# CORTEX_BRIDGE_URL=http://127.0.0.1:8765

# --- Batch Processing ---
# Enable/disable batch modules (all default to false)
# CORTEX_BATCH_RESEARCH_ENABLED=false
# CORTEX_BATCH_RECOMMENDATIONS_ENABLED=false
# CORTEX_BATCH_LEARNING_ENABLED=false
# CORTEX_BATCH_MAX_REQUESTS=10000
# CORTEX_BATCH_TIMEOUT_MINUTES=1440

# --- Supervisor ---
# CORTEX_SUPERVISOR_TICK_INTERVAL=30
# CORTEX_SUPERVISOR_MAX_CONCURRENT=3

# --- Testing ---
# Set to 1 to enable slow E2E tests
# CORTEX_SLOW_TESTS=0
