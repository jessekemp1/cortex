<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cortex.runtime</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CORTEX_DEV_ROOT__/cortex/venv/bin/python</string>
        <string>-m</string>
        <string>cortex.runtime</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__CORTEX_DEV_ROOT__/cortex</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__CORTEX_DEV_ROOT__/cortex</string>
        <key>CORTEX_ROOT_DIR</key>
        <string>__CORTEX_DEV_ROOT__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__CORTEX_DEV_ROOT__/cortex/logs/runtime.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__CORTEX_DEV_ROOT__/cortex/logs/runtime.stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
