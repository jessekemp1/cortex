include LICENSE
include README.md
include requirements.txt
include requirements-lock.txt

recursive-include cortex *.py

# Exclude non-package directories
prune tests
prune docs
prune examples
prune reports
prune analysis
prune scripts
prune MARKETING
prune FUTURE
prune STRATEGY
prune OPUS
prune GPT5
prune _dead
prune _archive*
prune mvp
prune cortex_mvp
prune golden-spec-method
prune config-backups
prune vision
prune site
prune dashboard
prune batch
prune automation
prune v2
prune v21

# Exclude runtime artifacts
exclude *.docx
exclude *.json
exclude *.yaml
exclude *.sh
exclude *.plist
exclude *.egg-info
